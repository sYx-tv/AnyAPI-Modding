// Generic owned command batches, reusable textures and DirectWrite layouts.
// Collection occurs before acquiring the game backbuffer; no game-specific UI.
#include "anyapi_gpu_draw_v1.h"
#include <dwrite.h>
#include <map>
#include <chrono>
#include <cmath>
#include <tuple>
namespace gpu_draw {
using Microsoft::WRL::ComPtr;
struct Command {AnyGpuCommandV1 value;std::wstring text;std::vector<AnyGpuPointV1> points;};
struct Texture {uint32_t w{},h{},pitch{};uint64_t revision{};std::vector<uint8_t> pixels;ComPtr<ID2D1Bitmap1> gpu;};
struct Renderer {void(*callback)(const AnyFrameV1*,void*){};void* user{};std::vector<Command> commands;std::map<uint64_t,Texture> textures;uint64_t uploads{},upload_bytes{},frames{},commands_total{};double collect_ms{},draw_ms{};uint64_t report_at{};};
static std::array<Renderer,32> renderers;
static thread_local bool collecting{};
static ComPtr<IDWriteFactory> write_factory;
static std::map<std::pair<float,bool>,ComPtr<IDWriteTextFormat>> fonts;
struct LayoutKey {std::wstring text;float size,w,h;uint32_t flags;bool operator<(const LayoutKey& b)const{return std::tie(text,size,w,h,flags)<std::tie(b.text,b.size,b.w,b.h,b.flags);}};
static std::map<LayoutKey,ComPtr<IDWriteTextLayout>> layouts;
static ComPtr<ID2D1SolidColorBrush> brush;
static ComPtr<ID2D1StrokeStyle> solid_stroke,dash_stroke;
static bool registration(void(*fn)(const AnyFrameV1*,void*),void* user){std::lock_guard<std::recursive_mutex> lock(platform::render_mutex);int owner=platform::current_plugin;if(owner<0||owner>=32||!fn||renderers[owner].callback)return false;renderers[owner].callback=fn;renderers[owner].user=user;return true;}
static Renderer* current(){int owner=platform::current_plugin;return collecting&&owner>=0&&owner<32?&renderers[owner]:nullptr;}
static bool texture(uint64_t id,uint32_t w,uint32_t h,uint32_t pitch,const uint8_t* pixels,uint64_t revision){auto r=current();if(!r||!id||!pixels||!w||!h||w>8192||h>8192||pitch<w*4||pitch>131072||uint64_t(pitch)*h>128ull*1024*1024)return false;auto found=r->textures.find(id);if(found==r->textures.end()&&r->textures.size()>=16)return false;auto& t=r->textures[id];if(t.w==w&&t.h==h&&t.revision==revision)return true;t.w=w;t.h=h;t.pitch=pitch;t.revision=revision;t.pixels.assign(pixels,pixels+size_t(pitch)*h);t.gpu.Reset();return true;}
static bool emit(const AnyGpuCommandV1* c){auto r=current();if(!r||!c||c->struct_size!=sizeof(*c)||c->kind<1||c->kind>ANY_GPU_CLIP_POP||r->commands.size()>=8192||c->text_length>8192||c->point_count>8192||(c->text_length&&!c->text)||(c->point_count&&!c->points))return false;for(float v:c->matrix)if(!std::isfinite(v))return false;for(float v:c->rect)if(!std::isfinite(v))return false;for(float v:c->source)if(!std::isfinite(v))return false;if(!std::isfinite(c->radius)||c->radius<0)return false;for(uint32_t i=0;i<c->point_count;++i)if(!std::isfinite(c->points[i].x)||!std::isfinite(c->points[i].y))return false;if(!std::isfinite(c->font_size)||c->font_size<=0||!std::isfinite(c->stroke)||c->stroke<0||!std::isfinite(c->opacity)||c->opacity<0||c->opacity>1)return false;Command copy;copy.value=*c;if(c->text_length)copy.text.assign(c->text,c->text_length);if(c->point_count)copy.points.assign(c->points,c->points+c->point_count);copy.value.text=nullptr;copy.value.points=nullptr;r->commands.push_back(std::move(copy));return true;}
static IDWriteTextFormat* font(float size,bool bold){if(!write_factory&&FAILED(DWriteCreateFactory(DWRITE_FACTORY_TYPE_SHARED,__uuidof(IDWriteFactory),(IUnknown**)write_factory.GetAddressOf())))return nullptr;auto key=std::make_pair(size,bold);auto& f=fonts[key];if(!f&&FAILED(write_factory->CreateTextFormat(L"Segoe UI",nullptr,bold?DWRITE_FONT_WEIGHT_BOLD:DWRITE_FONT_WEIGHT_NORMAL,DWRITE_FONT_STYLE_NORMAL,DWRITE_FONT_STRETCH_NORMAL,size,L"en-us",&f)))return nullptr;return f.Get();}
static IDWriteTextLayout* layout(const std::wstring& text,float size,float w,float h,uint32_t flags){auto f=font(size,(flags&ANY_GPU_BOLD)!=0);if(!f)return nullptr;LayoutKey key{text,size,std::max(1.f,w),std::max(1.f,h),flags};auto found=layouts.find(key);if(found!=layouts.end())return found->second.Get();if(layouts.size()>=1024)layouts.clear();ComPtr<IDWriteTextLayout> l;if(FAILED(write_factory->CreateTextLayout(text.c_str(),UINT32(text.size()),f,key.w,key.h,&l)))return nullptr;l->SetWordWrapping(flags&ANY_GPU_NOWRAP?DWRITE_WORD_WRAPPING_NO_WRAP:DWRITE_WORD_WRAPPING_WRAP);l->SetTextAlignment(flags&ANY_GPU_CENTER?DWRITE_TEXT_ALIGNMENT_CENTER:DWRITE_TEXT_ALIGNMENT_LEADING);l->SetParagraphAlignment(flags&ANY_GPU_VCENTER?DWRITE_PARAGRAPH_ALIGNMENT_CENTER:DWRITE_PARAGRAPH_ALIGNMENT_NEAR);DWRITE_TRIMMING trim{DWRITE_TRIMMING_GRANULARITY_CHARACTER,0,0};ComPtr<IDWriteInlineObject> ellipsis;if(SUCCEEDED(write_factory->CreateEllipsisTrimmingSign(f,&ellipsis)))l->SetTrimming(&trim,ellipsis.Get());auto ptr=l.Get();layouts.emplace(std::move(key),std::move(l));return ptr;}
static bool measure(const wchar_t* text,uint32_t n,float size,uint32_t flags,float* w,float* h){if(!current()||!text||n>8192||!w||!h||!std::isfinite(size)||size<=0)return false;auto l=layout(std::wstring(text,n),size,16384,16384,flags|ANY_GPU_NOWRAP);DWRITE_TEXT_METRICS m{};if(!l||FAILED(l->GetMetrics(&m)))return false;*w=m.widthIncludingTrailingWhitespace;*h=m.height;return true;}
static void reset(){brush.Reset();solid_stroke.Reset();dash_stroke.Reset();for(auto& r:renderers)for(auto& [id,t]:r.textures)t.gpu.Reset();}
static void call(Renderer* r,const AnyFrameV1* frame){__try{r->callback(frame,r->user);}__except(EXCEPTION_EXECUTE_HANDLER){platform::plugins[platform::current_plugin].faulted=true;r->commands.clear();}}
static bool collect(uint32_t owner,const AnyFrameV1& frame){auto& r=renderers[owner];r.commands.clear();if(!r.callback)return false;auto start=std::chrono::steady_clock::now();collecting=true;call(&r,&frame);collecting=false;r.collect_ms+=std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-start).count();return !r.commands.empty();}
static void render(uint32_t owner){auto& r=renderers[owner];auto ctx=platform::context2d.Get();if(!brush&&FAILED(ctx->CreateSolidColorBrush(D2D1::ColorF(1,1,1,1),&brush)))return;auto start=std::chrono::steady_clock::now();int clips=0;
 if(!solid_stroke){D2D1_STROKE_STYLE_PROPERTIES p=D2D1::StrokeStyleProperties();p.lineJoin=D2D1_LINE_JOIN_ROUND;platform::factory2d->CreateStrokeStyle(p,nullptr,0,&solid_stroke);p.dashStyle=D2D1_DASH_STYLE_DASH;platform::factory2d->CreateStrokeStyle(p,nullptr,0,&dash_stroke);}
 for(auto& owned:r.commands){auto& c=owned.value;ctx->SetTransform(D2D1::Matrix3x2F(c.matrix[0],c.matrix[1],c.matrix[2],c.matrix[3],c.matrix[4],c.matrix[5]));brush->SetColor(D2D1::ColorF(float((c.color>>16)&255)/255,float((c.color>>8)&255)/255,float(c.color&255)/255,float(c.color>>24)/255*c.opacity));auto rect=D2D1::RectF(c.rect[0],c.rect[1],c.rect[0]+c.rect[2],c.rect[1]+c.rect[3]);auto stroke=(c.flags&ANY_GPU_DASH)?dash_stroke.Get():solid_stroke.Get();
 switch(c.kind){
 case ANY_GPU_CLIP_PUSH:ctx->PushAxisAlignedClip(rect,D2D1_ANTIALIAS_MODE_PER_PRIMITIVE);++clips;break;
 case ANY_GPU_CLIP_POP:if(clips){ctx->PopAxisAlignedClip();--clips;}break;
 case ANY_GPU_RECT:if(c.flags&ANY_GPU_STROKE)ctx->DrawRectangle(rect,brush.Get(),c.stroke,stroke);else ctx->FillRectangle(rect,brush.Get());break;
 case ANY_GPU_ROUND_RECT:{auto rounded=D2D1::RoundedRect(rect,c.radius,c.radius);if(c.flags&ANY_GPU_STROKE)ctx->DrawRoundedRectangle(rounded,brush.Get(),c.stroke,stroke);else ctx->FillRoundedRectangle(rounded,brush.Get());break;}
 case ANY_GPU_ELLIPSE:{auto ellipse=D2D1::Ellipse(D2D1::Point2F(c.rect[0]+c.rect[2]/2,c.rect[1]+c.rect[3]/2),c.rect[2]/2,c.rect[3]/2);if(c.flags&ANY_GPU_STROKE)ctx->DrawEllipse(ellipse,brush.Get(),c.stroke,stroke);else ctx->FillEllipse(ellipse,brush.Get());break;}
 case ANY_GPU_LINE:ctx->DrawLine(D2D1::Point2F(c.rect[0],c.rect[1]),D2D1::Point2F(c.rect[2],c.rect[3]),brush.Get(),c.stroke,stroke);break;
 case ANY_GPU_POLYGON:if(owned.points.size()>=3){ComPtr<ID2D1PathGeometry> path;ComPtr<ID2D1GeometrySink> sink;if(SUCCEEDED(platform::factory2d->CreatePathGeometry(&path))&&SUCCEEDED(path->Open(&sink))){sink->BeginFigure(D2D1::Point2F(owned.points[0].x,owned.points[0].y),D2D1_FIGURE_BEGIN_FILLED);for(size_t i=1;i<owned.points.size();++i)sink->AddLine(D2D1::Point2F(owned.points[i].x,owned.points[i].y));sink->EndFigure(D2D1_FIGURE_END_CLOSED);sink->Close();if(c.flags&ANY_GPU_STROKE)ctx->DrawGeometry(path.Get(),brush.Get(),c.stroke,stroke);else ctx->FillGeometry(path.Get(),brush.Get());}}break;
 case ANY_GPU_TEXT:if(auto l=layout(owned.text,c.font_size,c.rect[2],c.rect[3],c.flags))ctx->DrawTextLayout(D2D1::Point2F(c.rect[0],c.rect[1]),l,brush.Get(),D2D1_DRAW_TEXT_OPTIONS_CLIP);break;
 case ANY_GPU_IMAGE:{auto found=r.textures.find(c.texture);if(found==r.textures.end())break;auto& t=found->second;if(!t.gpu){auto props=D2D1::BitmapProperties1(D2D1_BITMAP_OPTIONS_NONE,D2D1::PixelFormat(DXGI_FORMAT_B8G8R8A8_UNORM,D2D1_ALPHA_MODE_PREMULTIPLIED),96,96);if(FAILED(ctx->CreateBitmap(D2D1::SizeU(t.w,t.h),t.pixels.data(),t.pitch,&props,&t.gpu)))break;++r.uploads;r.upload_bytes+=t.pixels.size();}auto src=D2D1::RectF(c.source[0],c.source[1],c.source[0]+c.source[2],c.source[1]+c.source[3]);ctx->DrawBitmap(t.gpu.Get(),rect,c.opacity,D2D1_INTERPOLATION_MODE_LINEAR,src);break;}
 }}while(clips-- >0)ctx->PopAxisAlignedClip();ctx->SetTransform(D2D1::Matrix3x2F::Identity());r.draw_ms+=std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-start).count();++r.frames;r.commands_total+=r.commands.size();uint64_t now=GetTickCount64();if(!r.report_at)r.report_at=now;if(now-r.report_at>=10000){log_line(ANY_LOG_INFO,platform::plugins[owner].callbacks.id,("GPU_DRAW frames="+std::to_string(r.frames)+" collect_ms_avg="+std::to_string(r.collect_ms/r.frames)+" submit_ms_avg="+std::to_string(r.draw_ms/r.frames)+" commands_avg="+std::to_string(r.commands_total/r.frames)+" texture_uploads="+std::to_string(r.uploads)+" upload_bytes="+std::to_string(r.upload_bytes)+" note=cpu_timings_not_gpu_fence_time").c_str());r.frames=r.commands_total=0;r.collect_ms=r.draw_ms=0;r.report_at=now;}}
static const AnyGpuDrawV1 api{sizeof(AnyGpuDrawV1),1,registration,texture,emit,measure};
}
static const AnyGpuDrawV1* anyapi_gpu_draw_service(){return &gpu_draw::api;}
